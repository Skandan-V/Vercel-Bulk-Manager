{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/app(\\.html)?",
      "dest": "/dist/index.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    },
    {
      "src": "/contact(\\.html)?",
      "dest": "/contact.html"
    },
    {
      "src": "/terms(\\.html)?",
      "dest": "/terms.html"
    },
    {
      "src": "/(.*\\.(css|svg|png|jpg|jpeg|gif|webp|json|xml|txt|otf|woff|woff2))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
